{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observances",
  "type": "object",
  "required": ["version", "observances"],
  "properties": {
    "version": { "type": "integer" },
    "note": { "type": "string" },
    "observances": {
      "type": "array",
      "items": { "$ref": "#/$defs/observance" }
    }
  },
  "$defs": {
    "observance": {
      "type": "object",
      "required": ["id", "name", "type", "countries", "category"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["monthly", "yearly", "date", "rule"] },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 },
        "date": { "type": "string", "format": "date" },
        "days": { "type": "integer", "minimum": 2, "maximum": 366, "description": "Length in days when the observance runs longer than one day, counting the start date" },
        "rule": {
          "type": "object",
          "required": ["kind", "month", "weekday"],
          "properties": {
            "kind": { "enum": ["nth_weekday", "weekday_before"] },
            "month": { "type": "integer", "minimum": 1, "maximum": 12 },
            "weekday": { "type": "integer", "minimum": 1, "maximum": 7, "description": "1 = Monday ... 7 = Sunday" },
            "nth": { "enum": [-1, 1, 2, 3, 4, 5], "description": "-1 = last" },
            "day": { "type": "integer", "minimum": 1, "maximum": 31 }
          }
        },
        "countries": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^([A-Z]{2}|\\*)$" }
        },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "origin": { "type": "string" },
        "organizer": { "type": "string" },
        "names": { "type": "object", "additionalProperties": { "type": "string" } },
        "source_url": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "since": { "type": "integer" }
      }
    }
  }
}
